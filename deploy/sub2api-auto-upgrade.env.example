# Sub2API source auto-upgrade configuration.
# Copy to /etc/sub2api/auto-upgrade.env and adjust paths for the host.

# Source repository and branch.
REPO_DIR=/root/sub2api
UPSTREAM_REMOTE=origin
UPSTREAM_BRANCH=main
LOCAL_BRANCH=bnvnvnv/integration-v0.1.111

# Runtime install target. The script builds first, then atomically replaces this binary.
SERVICE_NAME=sub2api
INSTALL_DIR=/opt/sub2api
BINARY_PATH=/opt/sub2api/sub2api
HEALTH_URL=http://127.0.0.1:8080/health
HEALTH_TIMEOUT_SECONDS=60

# Validation/build policy.
RUN_GO_TESTS=1
RUN_FRONTEND_BUILD=1
FRONTEND_BUILD_CMD=npm run build
RUN_GENERATE=0
RESTART_SERVICE=1
FORCE_REBUILD=0

# Optional: push the merge commit back to the fork after successful deployment.
# Requires git credentials for FORK_REMOTE.
FORK_REMOTE=fork
PUSH_AFTER_UPGRADE=0

